<aura:component implements="lightning:actionOverride,flexipage:availableForAllPageTypes,force:hasSObjectName,lightning:hasPageReference" access="global">
    <aura:attribute name="pageReference" type="Object"/>
    <aura:attribute name="caseId" type="Id"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <!-- Wrap the LWC so we can use it as a standard action override -->
    <c:gnalLocationServicesFinder recordId="{!v.caseId}"/>
</aura:component>

